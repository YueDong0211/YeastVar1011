{
  "name": "yeastvar1011",
  "version": "22.1.1",
  "yvDistribution": "project-local",
  "description": "Evidence-linked study design and raw-read quality control for yeast single-cell research",
  "scripts": {
    "start": "node scripts/dev-server.cjs",
    "check": "node scripts/check-site.cjs",
    "doctor": "node scripts/doctor.cjs",
    "setup": "node scripts/doctor.cjs",
    "test:doctor": "node scripts/test.cjs --suite runtime --only qa-doctor.cjs",
    "test:server": "node scripts/test.cjs --suite runtime --only qa-dev-server.cjs",
    "test:public": "node scripts/test.cjs --suite browser",
    "test:release": "node scripts/test.cjs --suite release",
    "test:source": "node scripts/source-manifest.cjs --check",
    "release:manifest": "node scripts/source-manifest.cjs --write",
    "release:source": "node scripts/prepare-public.cjs",
    "test": "node scripts/test.cjs --suite core",
    "test:ci": "node scripts/test.cjs --suite ci",
    "test:catalogue": "node scripts/test.cjs --suite catalogue",
    "test:runtime": "node scripts/test.cjs --suite runtime",
    "test:portable": "node scripts/test.cjs --suite windows",
    "test:model": "node scripts/test.cjs --suite model",
    "test:list": "node scripts/test.cjs --list",
    "package:source": "python packaging/package-source.py",
    "package:analysis": "python packaging/package-analysis.py",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packaging/package-portable.ps1"
  },
  "keywords": [
    "Saccharomyces cerevisiae",
    "single-cell RNA sequencing",
    "research planning",
    "marker evidence",
    "expression variation",
    "quality control",
    "population genetics"
  ],
  "author": "Yue Dong",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "private": true,
  "dependencies": {
    "three": "0.186.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YueDong0211/YeastVar1011.git"
  },
  "homepage": "https://yuedong0211.github.io/YeastVar1011/",
  "bugs": {
    "url": "https://github.com/YueDong0211/YeastVar1011/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
